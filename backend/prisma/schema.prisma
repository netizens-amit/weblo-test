// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                String           @id @default(cuid())
  userId            String?
  name              String?
  originalPrompt    String?
  enhancedPrompt    String?          @db.Text
  
  // NEW: Store user preferences from prompt builder
  preferences       Json?
  
  status            ProjectStatus    @default(PENDING)
  progress          Int              @default(0)
  htmlContent       String           @db.Text
  cssContent        String           @db.Text
  aiModel           String?
  generationTimeMs  Int?
  tokensUsed        Int?
  estimatedCost     Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  versions          Version[]
  conversations     Conversation[]
  sessionMapping    SessionMapping?
  files             ProjectFile[]    // Persisted project files

  @@index([userId])
  @@index([status])
}

model Conversation {
  id            String              @id @default(cuid())
  projectId     String
  role          ConversationRole    // 'user' | 'assistant' | 'system'
  content       String              @db.Text
  metadata      Json?               // Store thinking messages, file changes, etc.
  createdAt     DateTime            @default(now())
  
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

enum ConversationRole {
  user
  assistant
  system
}

model Version {
  id             String   @id @default(cuid())
  projectId      String
  versionNumber  Int
  htmlContent    String   @db.Text
  cssContent     String   @db.Text
  jsContent      String   @db.Text
  changeReason   String
  createdAt      DateTime @default(now())
  
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
}

model SessionMapping {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  opencodeSessionId  String
  title              String
  directory          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([opencodeSessionId])
}

enum ProjectStatus {
  PENDING
  ENHANCING_PROMPT
  GENERATING_CODE
  COMPLETED
  FAILED
}

// 🆕 PROJECT FILE: Store generated files in database
model ProjectFile {
  id         String        @id @default(cuid())
  projectId  String
  path       String        // e.g., "src/App.jsx"
  content    String        @db.Text
  size       Int           @default(0)
  mimeType   String?       // e.g., "text/javascript"
  version    Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions   FileVersion[]

  @@unique([projectId, path])
  @@index([projectId])
}

// 🆕 FILE VERSION: Track file history for undo/diff
model FileVersion {
  id         String      @id @default(cuid())
  fileId     String
  version    Int
  content    String      @db.Text
  reason     String?     // "AI generation", "User edit", "Refinement"
  createdAt  DateTime    @default(now())

  file       ProjectFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId])
}

// 🆕 CONVERSATION SUMMARY: Cache AI-generated summaries
model ConversationSummary {
  id          String   @id @default(cuid())
  projectId   String   @unique
  summary     String   @db.Text
  messageCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}